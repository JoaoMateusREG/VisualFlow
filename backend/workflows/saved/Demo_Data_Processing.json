        "label": "2. Popular Dados (Python)",
        "inputs": {
          "code": "\ndf = dataframes['df_vendas']\nnovo_df = pd.DataFrame([\n    ['Notebook', 'Eletrônicos', 5000],\n    ['Mouse', 'Eletrônicos', 150],\n    ['Cadeira', 'Móveis', 800],\n    ['Mesa', 'Móveis', 1200],\n    ['Teclado', 'Eletrônicos', 300]\n], columns=['Produto', 'Categoria', 'Valor'])\ndataframes['df_vendas'] = novo_df\nprint('Dados populados')\n"
        },
        "position": {
          "x": 100,
          "y": 250
        }
      },
      {
        "id": "d6603844-fc22-46c9-bbed-61ea30563e31",
        "type": "groupData",
        "label": "3. Agrupar por Categoria",
