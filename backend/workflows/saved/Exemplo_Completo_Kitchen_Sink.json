    "executionOrder": [
      {
        "id": "f2a68071-11ba-4e6a-a84f-f2d8ceeab539",
        "type": "variable",
        "label": "1. Definir Variável",
        "inputs": {
          "operation": "set",
          "variable_name": "base_url",
          "variable_value": "https://example.com"
        },
        "position": {
          "x": 100,
          "y": 100
        }
      },
      {
        "id": "9bc43454-5c8e-4e5a-a0f2-da054071b927",
        "type": "openSite",
        "label": "2. Abrir Site",
        "inputs": {
          "url": "${base_url}",
          "wait_time": "3"
        },
        "position": {
          "x": 100,
          "y": 250
        }
      },
      {
        "id": "d2ba2eda-ceb4-4866-b889-42fcbbb87073",
        "type": "wait",
        "label": "3. Aguardar Título",
        "inputs": {
          "wait_type": "element",
          "selector_type": "tag_name",
          "selector_value": "h1",
          "wait_condition": "visibility_of_element_located",
          "timeout": "10"
        },
        "position": {
          "x": 100,
          "y": 400
        }
      },
      {
        "id": "7cb5ffbf-1df2-4a78-8852-58ccb0deb696",
        "type": "extractText",
        "label": "4. Extrair Domínio",
        "inputs": {
          "selector_type": "xpath",
          "selector_value": "//p",
          "regex_pattern": "Domain",
          "variable_name": "domain_text",
          "wait_timeout": "5",
          "fallback_to_body": "true"
        },
        "position": {
          "x": 100,
          "y": 550
        }
      },
      {
        "id": "4468915d-4cad-4e15-8847-5c1f60b3f50d",
        "type": "executePython",
        "label": "5. Processar Python",
        "inputs": {
          "code": "print(f'Texto extraído: {variables.get(\"domain_text\", \"N/A\")}')\nvariables['processed_text'] = variables.get('domain_text', '').upper()"
        },
        "position": {
          "x": 100,
          "y": 700
        }
      },
      {
        "id": "72eb8201-f894-4a8e-8b42-8087d20e65ac",
        "type": "condition",
        "label": "6. Validar Texto",
        "inputs": {
          "condition_type": "variable_comparison",
          "variable_name": "processed_text",
          "comparison_operator": "!=",
          "comparison_value": ""
        },
        "position": {
          "x": 100,
          "y": 850
        }
      },
      {
        "id": "12f7c37c-ebfc-4c9d-aad0-c8b782c16533",
        "type": "executeScript",
        "label": "7. Alert JS (True)",
        "inputs": {
          "script": "console.log('Texto validado com sucesso!'); return 'ok';"
        },
        "position": {
          "x": -100,
          "y": 1000
        }
      },
      {
        "id": "58b03661-5c29-4598-ba3c-aebb01d14cad",
        "type": "sleep",
        "label": "8. Pausa (False)",
        "inputs": {
          "duration": "2",
          "description": "Pausa triste por falha"
        },
        "position": {
          "x": 300,
          "y": 1000
        }
      },
      {
        "id": "f61cfd3e-b97a-4ab2-a196-152f55d54646",
